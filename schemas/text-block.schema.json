{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "three-text-block",
  "title": "Text Block",
  "description": "Add flat 3D text to the environment. Rendered as canvas-backed text (works on both the WebGPU and WebGL/XR paths); laid out in a 2-unit-wide wrap box with ~0.35-unit glyphs at scale 1.",
  "type": "object",
  "required": ["textcontent"],
  "properties": {
    "textcontent": {
      "type": "string",
      "description": "The text string to display"
    },
    "textcolor": {
      "type": "string",
      "default": "#ffffff",
      "description": "Text color in hex format"
    },
    "positionx": {
      "type": "number",
      "default": 0,
      "description": "X position in world space"
    },
    "positiony": {
      "type": "number",
      "default": 0,
      "description": "Y position in world space"
    },
    "positionz": {
      "type": "number",
      "default": 0,
      "description": "Z position in world space"
    },
    "rotationx": {
      "type": "number",
      "default": 0,
      "description": "Rotation around X axis (in radians)"
    },
    "rotationy": {
      "type": "number",
      "default": 0,
      "description": "Rotation around Y axis (in radians)"
    },
    "rotationz": {
      "type": "number",
      "default": 0,
      "description": "Rotation around Z axis (in radians)"
    },
    "scalex": {
      "type": "number",
      "default": 1,
      "description": "Scale factor on X axis"
    },
    "scaley": {
      "type": "number",
      "default": 1,
      "description": "Scale factor on Y axis"
    },
    "scalez": {
      "type": "number",
      "default": 1,
      "description": "Scale factor on Z axis"
    }
  },
  "additionalProperties": false
}

